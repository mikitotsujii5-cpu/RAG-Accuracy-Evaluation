{
  "name": "toyota-rag-phase-evaluation",
  "description": "Project-scoped fixed-dataset Phase 1-5 retrieval, answer, judge, latency, and improvement evaluation.",
  "format": "MULTI_TASK",
  "max_concurrent_runs": 1,
  "queue": {
    "enabled": true
  },
  "parameters": [
    {
      "name": "eval_run_id",
      "default": ""
    }
  ],
  "performance_target": "PERFORMANCE_OPTIMIZED",
  "environments": [
    {
      "environment_key": "toyota_rag_evaluation_serverless_v5",
      "spec": {
        "environment_version": "5",
        "dependencies": [
          "databricks-sdk==0.135.0",
          "databricks-ai-search==0.78"
        ]
      }
    }
  ],
  "tasks": [
    {
      "task_key": "evaluate_phases",
      "description": "Hash-verify one evaluation batch and idempotently write all Phase results and suggestions.",
      "environment_key": "toyota_rag_evaluation_serverless_v5",
      "timeout_seconds": 14400,
      "max_retries": 1,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true,
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<RUN_AS_USER_EMAIL>/toyota-rag-accuracy-eval/jobs/evaluation_job",
        "source": "WORKSPACE",
        "base_parameters": {
          "eval_run_id": "{{job.parameters.eval_run_id}}",
          "MLFLOW_EXPERIMENT_PATH": "<MLFLOW_EXPERIMENT_PATH>",
          "MLFLOW_EXPERIMENT_ID": "<MLFLOW_EXPERIMENT_ID>",
          "MLFLOW_TRACING_SQL_WAREHOUSE_ID": "<SQL_WAREHOUSE_ID>"
        }
      }
    }
  ],
  "run_as": {
    "user_name": "<RUN_AS_USER_EMAIL>"
  },
  "tags": {
    "application": "toyota-rag-accuracy-eval",
    "compute_profile": "serverless-performance-optimized-v5"
  }
}
