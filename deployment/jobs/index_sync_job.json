{
  "name": "toyota-rag-index-sync",
  "description": "On-demand synchronization and readiness verification for the allow-listed Toyota RAG Delta Sync index.",
  "format": "MULTI_TASK",
  "max_concurrent_runs": 1,
  "queue": {
    "enabled": true
  },
  "job_clusters": [
    {
      "job_cluster_key": "toyota_rag_dbr18",
      "new_cluster": {
        "spark_version": "18.x-scala2.13",
        "node_type_id": "Standard_D4s_v5",
        "driver_node_type_id": "Standard_D4s_v5",
        "runtime_engine": "STANDARD",
        "data_security_mode": "USER_ISOLATION",
        "num_workers": 1,
        "azure_attributes": {
          "availability": "ON_DEMAND_AZURE",
          "first_on_demand": 1,
          "spot_bid_max_price": -1
        },
        "custom_tags": {
          "application": "toyota-rag-accuracy-eval"
        }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "sync_baseline_index",
      "description": "Verify the fixed source and trigger the AI Search Delta Sync pipeline.",
      "job_cluster_key": "toyota_rag_dbr18",
      "timeout_seconds": 3600,
      "max_retries": 1,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true,
      "libraries": [
        {
          "pypi": {
            "package": "databricks-sdk==0.135.0"
          }
        }
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<RUN_AS_USER_EMAIL>/toyota-rag-accuracy-eval/jobs/index_sync_job",
        "source": "WORKSPACE"
      }
    }
  ],
  "run_as": {
    "user_name": "<RUN_AS_USER_EMAIL>"
  },
  "tags": {
    "application": "toyota-rag-accuracy-eval",
    "environment": "field-eng-east"
  }
}
