{
  "name": "toyota-rag-index-sync",
  "description": "On-demand synchronization and readiness verification for the allow-listed Toyota RAG Delta Sync index.",
  "format": "MULTI_TASK",
  "max_concurrent_runs": 1,
  "queue": {
    "enabled": true
  },
  "performance_target": "PERFORMANCE_OPTIMIZED",
  "environments": [
    {
      "environment_key": "toyota_rag_index_sync_serverless_v5",
      "spec": {
        "environment_version": "5",
        "dependencies": [
          "databricks-sdk==0.135.0"
        ]
      }
    }
  ],
  "tasks": [
    {
      "task_key": "sync_baseline_index",
      "description": "Verify the fixed source and trigger the AI Search Delta Sync pipeline.",
      "environment_key": "toyota_rag_index_sync_serverless_v5",
      "timeout_seconds": 3600,
      "max_retries": 1,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true,
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<RUN_AS_USER_EMAIL>/toyota-rag-accuracy-eval/jobs/index_sync_job",
        "source": "WORKSPACE"
      }
    }
  ],
  "run_as": {
    "user_name": "<RUN_AS_USER_EMAIL>"
  },
  "tags": {
    "application": "toyota-rag-accuracy-eval",
    "compute_profile": "serverless-performance-optimized-v5"
  }
}
